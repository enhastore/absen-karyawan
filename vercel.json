{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/backend/uploads/$1" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/", "destination": "/admin/index.html" },
    { "source": "/((?!api|admin|uploads).*)", "destination": "/admin/$1" }
  ]
}
